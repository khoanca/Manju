# Manju — biến môi trường (copy thành .env, điền giá trị thật; .env đã gitignore)

# Pass 2 cloud (tuỳ chọn — thiếu thì dùng Ollama local)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# FR-10 tier cloud STT (tuỳ chọn — thiếu SONIOX_API_KEY thì app chạy offline 100%,
# start card tự ẩn option Online)
SONIOX_API_KEY=

# Chỉ cần cho benchmark scripts/bench_cloud_stt.py (không dùng trong app)
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
GLADIA_API_KEY=

# Tuỳ chọn khác (mặc định đã hợp lý)
# ASR_ENGINE=            # ép tier: mlx | cuda | cpu (phục vụ test)
# MAX_LIVE_SESSIONS=2
# LIVE_MLX_MODEL=mlx-community/whisper-large-v3-turbo
# MANJU_MLX_REVISE=0     # CHỈ bật khi mlx-whisper có beam search
# APIFY_TOKEN=           # US-818: quét caption TikTok qua Apify (opt-in)
